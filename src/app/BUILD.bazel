load("@mgbowen_bazel_create_dmg//lib:defs.bzl", "macos_dmg")
load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "FasterSwiper_Views",
    srcs = [
        "ViewModels/MockSettingsViewModel.swift",
        "ViewModels/SettingsViewModelProtocol.swift",
        "Views/SettingsView.swift",
    ],
    module_name = "FasterSwiper_Views",
)

swift_library(
    name = "FasterSwiper_lib",
    srcs = [
        "DaemonManager.swift",
        "FasterSwiperApp.swift",
        "PermissionsMonitor.swift",
        "SettingsStore.swift",
        "ViewModels/SettingsViewModel.swift",
    ],
    module_name = "FasterSwiper_App",
    deps = [
        ":FasterSwiper_Views",
        "//src/public/swift",
    ],
)

macos_application(
    name = "FasterSwiper_app",
    bundle_id = "com.martin.FasterSwiper.Command",
    bundle_name = "FasterSwiper",
    # rules_apple requires Icon Composer for deployment targets >= macOS 26.
    app_icons = glob(["AppIcon.icon/**"]),
    # Do not run bundle codesigning. Apple Silicon's linker may still emit an
    # ad-hoc Mach-O signature; this is not a Developer ID or notarized build.
    features = ["disable_legacy_signing"],
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    resources = ["//:LICENSE", "//:ATTRIBUTION.md"],
    deps = [
        ":FasterSwiper_lib",
        "@abseil-cpp//absl/log:flags",
    ],
)

macos_dmg(
    name = "FasterSwiper_dmg",
    src = ":FasterSwiper_app",
    tags = ["manual"],
)
